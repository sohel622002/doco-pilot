# Where the client dev/preview server is running
BASE_URL=http://localhost:5173

# Where the API server is running (used by fixtures to talk to the backend
# directly, e.g. cleanup)
API_URL=http://localhost:3001

# Prefix used for generated test user emails, e.g. e2e+<random>@doco-pilot.test
TEST_EMAIL_DOMAIN=doco-pilot.test

# Set to "1" to skip tests that need a real Docker agent (servers/containers/
# images/volumes/networks). Useful if you're only running auth/landing tests
# and don't have Docker available.
SKIP_AGENT_TESTS=0
