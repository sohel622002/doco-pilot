PORT=3001
NODE_ENV=development

# Origin allowed to make CORS requests (your client URL)
FRONTEND_URL=http://localhost:5173

# JWT signing
JWT_SECRET=
JWT_EXPIRES_IN=15m
# Optional: reject requests when client IP differs from IP at token issue.
# Leave unset/false on Render/Cloudflare — proxy/IPv6 churn causes false mismatches.
# BIND_JWT_TO_IP=true

# 32-byte (64 hex char) key used for AES-256-GCM encryption of agent credentials
MASTER_ENCRYPTION_KEY=

# Supabase project config (use the service role key — server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WebSocket URL handed to agents in the generated install command (required — no placeholder fallback)
BACKEND_WS_URL=ws://localhost:3001/ws

# Published agent image used in the generated docker run command
AGENT_IMAGE=ghcr.io/sohel622002/doco-pilot-agent:latest

# Resend (https://resend.com) — used for email verification and password
# reset delivery. Free tier: 100 emails/day, 3,000/month, no card required.
# Leave unset and these emails are logged instead of sent (dev fallback).
RESEND_API_KEY=
MAIL_FROM=doco-pilot <onboarding@resend.dev>

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Create an OAuth 2.0 Client ID (Web application). Authorized redirect URI:
#   http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
